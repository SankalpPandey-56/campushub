# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Locally we run Postgres in Docker:
#   docker run -d --name campushub-postgres -e POSTGRES_PASSWORD=campushub \
#     -e POSTGRES_USER=campushub -e POSTGRES_DB=campushub -p 5434:5432 postgres:16-alpine
DATABASE_URL="postgresql://campushub:campushub@localhost:5434/campushub"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET=""

# Public URL of the app (used for OAuth callback + emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Admin ────────────────────────────────────────────────────────────────────
# The Google account with this email becomes ADMIN on login
ADMIN_EMAIL=""

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Any SMTP provider works (Gmail app-password, Resend, SES...). Leave SMTP_HOST
# empty to run without outbound email — admin notifications are also stored in
# the Notifications table as a fallback.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CampusHub <no-reply@campushub.app>"

# ── Phone OTP ────────────────────────────────────────────────────────────────
# "console" logs the OTP to the server console (local dev only).
# "twilio" sends via Twilio Verify — set the three vars below.
PHONE_AUTH_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# ── Optional: Feature-base campus (used by the seeder) ───────────────────────
SEED_CAMPUS_NAME="Rishihood University"
